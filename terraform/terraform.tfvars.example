project_name = "power-runtime"
region       = "us-west-2"

# Cognito is not used (CDK SecretsStack + user_id session). No admin password needed.

# Set true and supply URIs to skip ARM64 docker build during apply
# skip_docker_build  = true
# runtime_image_uri  = "123456789012.dkr.ecr.us-west-2.amazonaws.com/power-runtime_langgraph:latest"
# web_image_uri      = "123456789012.dkr.ecr.us-west-2.amazonaws.com/ecr-for-power-runtime:latest"
